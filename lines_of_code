def write_particles(
    file_prefix,
    particles,
    theta,
    velocity,
    ang_velocity,
    forces_self_propulsion,
    forces_chemotaxis,
    forces_interaction,
    forces_wall,
    timestep,
    simulation_time,
    save_forces=False,
):
    t = timestep % particles.shape[1]

    data = {
        "timestep": timestep,
        "simulation_time": simulation_time,
        "x": particles[:, t, 0],
